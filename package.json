{
  "name": "savedby",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@mux/mux-player-react": "^3.13.0",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.5.0",
    "@sanity/asset-utils": "^2.3.0",
    "@sanity/client": "^7.14.1",
    "@sanity/color-input": "^6.0.4",
    "@sanity/image-url": "^2.0.3",
    "@sanity/ui": "^3.1.11",
    "@sanity/vision": "^5.7.0",
    "clsx": "^2.1.1",
    "gsap": "^3.14.2",
    "klaviyo-api": "^22.0.1",
    "lenis": "^1.3.18",
    "leva": "^0.10.1",
    "next": "16.1.6",
    "next-sanity": "^12.0.16",
    "next-view-transitions": "^0.3.5",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "sanity": "^5.7.0",
    "sanity-plugin-mux-input": "^2.19.0",
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "eslint-config-prettier": "^10.1.8",
    "lint-staged": "^16.2.7",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "stylelint": "^17.13.0",
    "stylelint-config-recommended": "^18.0.0",
    "stylelint-config-tailwindcss": "^1.0.1",
    "stylelint-order": "^8.1.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "postcss": {
    "plugins": {
      "@tailwindcss/postcss": {}
    }
  },
  "prettier": {
    "arrowParens": "avoid",
    "bracketSameLine": true,
    "bracketSpacing": true,
    "printWidth": 80,
    "proseWrap": "always",
    "semi": false,
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "es5",
    "useTabs": false,
    "plugins": [
      "prettier-plugin-tailwindcss"
    ]
  },
  "stylelint": {
    "extends": [
      "stylelint-config-recommended",
      "stylelint-config-tailwindcss"
    ],
    "plugins": [
      "stylelint-order"
    ],
    "rules": {
      "no-descending-specificity": null,
      "order/properties-alphabetical-order": true,
      "selector-type-no-unknown": [
        true,
        {
          "ignore": [
            "custom-elements"
          ]
        }
      ],
      "media-query-no-invalid": [
        true,
        {
          "ignoreFunctions": [
            "theme",
            "/^get.*$/"
          ]
        }
      ]
    }
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{json,css,md,mdx,yaml,yml}": [
      "prettier --write"
    ]
  }
}
